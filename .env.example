# === FáGlè environment variables ===

# Set to "true" to force Demo Mode (mock data, no Supabase required).
# If Supabase vars below are missing, Demo Mode is used automatically either way.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase project (leave blank to stay in Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required in the `x-api-key` header of POST /api/sensors/ingest
SENSOR_INGEST_API_KEY=change-me-dev-key

# Optional: protects /api/cron/monthly-reports from public invocation
CRON_SECRET=change-me-cron-secret

# Real weather data comes from Open-Meteo (https://open-meteo.com), which is
# free and requires NO API key — services/weatherService.js calls it directly
# whenever a plot has a latitude/longitude. This variable is unused today; it
# is kept as a documented extension point if FáGlè ever needs to switch to a
# paid/keyed provider (services/weatherService.js falls back to a realistic
# simulated forecast whenever the real provider is unreachable).
WEATHER_API_KEY=
